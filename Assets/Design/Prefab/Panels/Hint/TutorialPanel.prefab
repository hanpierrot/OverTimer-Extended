--- !u!114 &3010344600024332132
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3052933158902068585}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 657d0c3e15d23804da81a9aab19f0966, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialPanel
  stepImage: {fileID: 502044117639768375}
  stepText: {fileID: 3861422646456867923}
  progressText: {fileID: 8226096470634578165}
  skipButton: {fileID: 3102643533138906782}
  steps:
  - text: '<color=#FFD166>You have 2 minutes to live.</color>

      Get the clock
      to <color=#FFD166>10:00</color> before it hits <color=#FFD166>0:00</color>.'
    image: {fileID: 0}
  - text: '<color=#FFD166>Click</color> things to use them. <color=#FFD166>Drag</color>
      things to move them.

      If something doesn''t respond, it may be blocked,
      so look for a hint.'
    image: {fileID: 0}
  - text: 'Everything on the desk can earn <color=#FFD166>money</color>.

      Money
      alone doesn''t save you.'
    image: {fileID: 0}
  - text: 'Click the <color=#FFD166>Meter</color> to turn money into time: <color=#FFD166>$1
      = 1 second.</color>

      It spends all your money at once.'
    image: {fileID: 0}
  - text: 'Hold the <color=#FFD166>arrow buttons</color> to look around the room.

      Now
      try your luck.'
    image: {fileID: 0}
