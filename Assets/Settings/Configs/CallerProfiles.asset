  telemarketerScript:
  - callerLine: Hello there! Do you have a minute to talk about your car's extended
      warranty?
    replyLabel: Uh-huh.
  - callerLine: Wonderful! It will only take a moment of your time...
    replyLabel: Hang up.
  clientScript:
  - callerLine: I am interested in buying one of your products, will you sign me
      up for it?
    replyLabel: Got you.
  - callerLine: Awesome, thank you!
    replyLabel: Hang up.
  itrsScript:
  - callerLine: This is the Internal Time Revenue Service. We are calling about your
      account.
    replyLabel: Go on.
  - callerLine: Fine, we will give you a little more time to pay. Do not make us
      call again.
    replyLabel: Hang up.
  itrsNoBillLine: It looks like you already paid. Fine, we will give your next bill
    a little more time. Goodbye.
  noReplyLine: Hello? Are you there?
